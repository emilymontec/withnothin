NODE_ENV=development
PORT=4000

# PostgreSQL (local en docker-compose, o el connection string de Supabase)
DATABASE_URL=postgresql://withnothin:withnothin@localhost:5432/withnothin?schema=public

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Bucket de Supabase Storage donde se guardan las imágenes de posts/perfiles
SUPABASE_STORAGE_BUCKET=media

# JWT Secret del proyecto de Supabase (Project Settings > API > JWT Settings).
# NestJS lo usa SOLO para verificar tokens, nunca para emitirlos.
JWT_PUBLIC_KEY_OR_SECRET=replace-me

# Orígenes permitidos, separados por coma
CORS_ORIGIN=http://localhost:3000
